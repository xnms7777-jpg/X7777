                var deviceCheck = window.devicecheck();
                var innerWidth = window.innerWidth;
                var scenario = 'desktop';
                if (deviceCheck == 'mobile' || (deviceCheck == 'tablet' && innerWidth < 768)) {
                    scenario = 'mobile';
